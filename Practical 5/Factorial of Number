public class factorial{
  public static void main(String args[]){
   fact1(6);
   fact2(6);
   fact3(6);
  }
int fact1(int num){
    if(num>-1){
      if(num<2){
        return 1;
      }
      int fact=2;
      for(;num>2;){
        fact*=num--;
      }
      return fact;
    }else{
      return -1;
    }
  }
  
  int fact2(int num){
    if(num>-1){
      if(num<2){
        return 1;
      }
      int fact=2;
      while(num>2){
        fact*=num--;
      }
      return fact;
    }else{
      return -1;
    }
  }

    int fact3(int num) {
    if (num < 0) {
       return -1;
    }
    if (num <= 1) { 
        return 1;
    }
    return num * fact3(num - 1);
}

}
