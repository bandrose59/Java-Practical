    static public int fact1(int num) {
        int fact = 1 ;
        for (int i = 1 ; i<=num ; i++) {
            fact = fact * i ;
        }
        return fact ;
    }


    static public int fact2(int num) {
        int fact = 1 ;
        int i = 1 ;
        while(i<=num) {
            fact = fact * i ;
            i++ ;
        }
        return fact ;
    }


    static int fact3(int num) {
    if (num < 0) {
       return -1;
    }
    if (num <= 1) { 
        return 1;
    }
    return num * fact3(num - 1);
}

